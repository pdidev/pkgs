#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

include /usr/share/dpkg/architecture.mk
include /usr/share/mpi-default-dev/debian_defaults
ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)))
	CMAKEFLAGS += -DBUILD_TESTING=OFF
endif
PKG_VERSION := $(shell dpkg-parsechangelog -S version | sed 's/-.*//')
FLAVORS = $(shell dh_listpackages | grep '^pdiplugin-mpi-' | sed 's/^pdiplugin-mpi-//')


%:
	dh $@

override_dh_auto_clean:
	set -e; for FLAVOR in $(FLAVORS) ;\
	do \
		dh_auto_clean -Bbuild-$${FLAVOR} -ppdiplugin-mpi-$${FLAVOR} ;\
	done

# Hydra, the mpiexec of MPICH, speaks PMI-1 only: it launches singletons of a libmpich built for PMIx, as Ubuntu 24.04's is.
# Open MPI's mpiexec runs a PMIx server, so it launches these as one job.
override_dh_auto_configure:
	set -e; for FLAVOR in $(FLAVORS) ;\
	do  \
		MPIEXEC=/usr/bin/mpiexec.$${FLAVOR} ;\
		if [ "$${FLAVOR}" = mpich ] && mpichversion | grep -q -e '--with-pmix' ;\
		then \
			MPIEXEC=/usr/bin/mpiexec.openmpi ;\
		fi ;\
		dh_auto_configure -D plugins/mpi -Bbuild-$${FLAVOR} -ppdiplugin-mpi-$${FLAVOR} -- \
			-DCMAKE_BUILD_TYPE=Release \
			-DINSTALL_PDIPLUGINDIR=/usr/lib/$(DEB_HOST_MULTIARCH)/pdi/plugins_$(PKG_VERSION)/$${FLAVOR} \
			-DMPI_C_COMPILER=mpicc.$${FLAVOR} \
			-DMPI_CXX_COMPILER=mpicxx.$${FLAVOR} \
			-DMPI_Fortran_COMPILER=mpif90.$${FLAVOR} \
			-DMPIEXEC_EXECUTABLE=$${MPIEXEC} \
			$(CMAKEFLAGS);\
	done

override_dh_auto_build:
	set -e; for FLAVOR in $(FLAVORS) ;\
	do \
		dh_auto_build -Bbuild-$${FLAVOR} -ppdiplugin-mpi-$${FLAVOR} ;\
	done

override_dh_auto_install:
	set -e; for FLAVOR in $(FLAVORS) ;\
	do \
		dh_auto_install -Bbuild-$${FLAVOR} -ppdiplugin-mpi-$${FLAVOR} ;\
	done

# Let the tests run more processes than there are cores: Open MPI up to 4 reads OMPI_MCA_rmaps_base_oversubscribe,
# Open MPI 5 and later map processes with PRRTE, which reads PRTE_MCA_rmaps_default_mapping_policy instead,
# renamed PRTE_MCA_mapby in Open MPI 6: setting both spares the latter its deprecation warning.
override_dh_auto_test:
	set -e; for FLAVOR in $(FLAVORS) ;\
	do \
		export OMPI_ALLOW_RUN_AS_ROOT=1 OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 OMPI_MCA_rmaps_base_oversubscribe=1 ;\
		export PRTE_MCA_rmaps_default_mapping_policy=:oversubscribe PRTE_MCA_mapby=:oversubscribe ;\
		export PDI_PLUGIN_PATH=/usr/lib/$(DEB_HOST_MULTIARCH)/pdi/plugins_$(PKG_VERSION)/$${FLAVOR} ;\
		dh_auto_test -Bbuild-$${FLAVOR} -ppdiplugin-mpi-$${FLAVOR} ;\
	done

override_dh_installdeb:
	set -e; for FLAVOR in $(FLAVORS) ; do for SUFFIX in prerm postinst ;\
		do cp debian/pdiplugin-mpi-FLAVOR.$${SUFFIX} debian/pdiplugin-mpi-$${FLAVOR}.$${SUFFIX} ;\
	done; done
	dh_installdeb \
		-D DEB_HOST_MULTIARCH=$(DEB_HOST_MULTIARCH) \
		-D PKG_VERSION=$(PKG_VERSION) \
		-D ARCH_DEFAULT_MPI_IMPL=$(ARCH_DEFAULT_MPI_IMPL)
