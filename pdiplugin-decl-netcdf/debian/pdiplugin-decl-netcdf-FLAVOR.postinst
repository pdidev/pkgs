#!/bin/sh
set -e

FLAVOR=`printf #PACKAGE#|sed 's/pdiplugin-decl-netcdf-//'`

case ${FLAVOR} in
mpi)
	PRIORITY=30
	;;
serial)
	PRIORITY=20
	;;
*)
	exit 1
	;;
esac

case "$1" in
configure)
	update-alternatives \
		--install \
		/usr/lib/#DEB_HOST_MULTIARCH#/pdi/plugins_#PKG_VERSION#/libpdi_decl_netcdf_plugin.so \
		pdi-#PKG_VERSION#_decl_netcdf_plugin.so-#DEB_HOST_MULTIARCH# \
		/usr/lib/#DEB_HOST_MULTIARCH#/pdi/plugins_#PKG_VERSION#/${FLAVOR}/libpdi_decl_netcdf_plugin.so \
		"${PRIORITY}"
;;
*)
	# nothing to do
;;
esac

#DEBHELPER#
